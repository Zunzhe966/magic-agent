{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "魔法代理",
  "version": "0.1.0",
  "identifier": "com.magic.agent",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "魔法代理",
        "width": 1240,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 680,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
