{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "尊者魔法代理",
  "version": "0.2.2",
  "identifier": "com.magic.agent",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir \"/Volumes/A区/魔法代理/ui\" build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "尊者魔法代理",
        "width": 1240,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 680,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns"
    ],
    "resources": {
      "resources/bin/mihomo": "bin/mihomo",
      "resources/geo/geoip.dat": "geo/geoip.dat",
      "resources/geo/geosite.dat": "geo/geosite.dat",
      "resources/geo/ASN.mmdb": "geo/ASN.mmdb",
      "resources/geo/geoip.metadb": "geo/geoip.metadb"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "http://127.0.0.1:7878/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzNDM4REZDNDkyMzIwNzQKUldSMElDTkovSTFEODFBNUtlYmRxallORkE3bko1ZiszOHVIV0VsU2NGSTRLK1lGdUhyM2xSajgK",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
