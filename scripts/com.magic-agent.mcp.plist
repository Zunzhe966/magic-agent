<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.magic-agent.mcp</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/绝对路径/魔法代理/mcp/server.py</string>
        <string>--http</string>
        <string>19092</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- 2026-09-03 修复：去掉 KeepAlive 常驻。MCP 服务随登录启动即可，
         崩溃不自动复活（重新登录或手动 magic-agent-mcp.sh start 拉起）。
         KeepAlive 会造成「App 关了服务还在」的失控感，且掩盖崩溃问题。 -->
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/magic-agent-mcp.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/magic-agent-mcp.log</string>
</dict>
</plist>
