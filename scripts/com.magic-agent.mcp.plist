<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.magic-agent.mcp</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/绝对路径/魔法代理/mcp/server.py</string>
        <string>--http</string>
        <string>19092</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/magic-agent-mcp.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/magic-agent-mcp.log</string>
</dict>
</plist>
